{
  "schemaVersion": 1,
  "about": "Loom default platform mapping: RomM 5.3.1 platform slug (or server folder name) -> Cocoon system folder. Folder names from Cocoon's platforms/index.json (2026-10-13). Edit or override in Loom's Settings; export/import uses this same format.",
  "defaults": {
    "archive": "keep",
    "multiDisc": "m3u_dir",
    "include": [
      "game"
    ]
  },
  "platforms": [
    {"match": {"slug": "nes"}, "folder": "nes", "aliases": ["famicom"]},
    {"match": {"slug": "famicom"}, "folder": "nes", "aliases": ["famicom"], "note": "Cocoon treats famicom as an alias of nes"},
    {"match": {"slug": "fds"}, "folder": "fds"},
    {"match": {"slug": "snes"}, "folder": "snes", "aliases": ["sfc", "snesna"]},
    {"match": {"slug": "sfam"}, "folder": "snes", "aliases": ["sfc", "snesna"], "note": "Super Famicom"},
