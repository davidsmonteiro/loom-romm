<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window theme only: Compose draws everything. Charcoal background avoids a white flash. -->
    <style name="Theme.Loom" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/loom_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- The second screen's window: black, edge to edge, never a floating dialog. -->
    <style name="Theme.Loom.SecondScreen" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowIsFloating">false</item>
    </style>
</resources>
