<?xml version="1.0" encoding="utf-8"?>
<!-- Self-hosted RomM is often reached over plain HTTP on a LAN or Tailnet (WireGuard already
     encrypts that link), or over HTTPS with a private CA. Loom warns in the UI when HTTP is used
     for a public host. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
