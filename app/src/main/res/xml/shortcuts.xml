<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher shortcuts (long-press Loom's icon). targetPackage must match the applicationId. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="sync_library"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_sync"
        android:shortcutShortLabel="@string/shortcut_sync_short"
        android:shortcutLongLabel="@string/shortcut_sync_long">
        <intent
            android:action="ro.davidmontei.loom.action.SYNC_CATALOG"
            android:targetPackage="ro.davidmontei.loom"
            android:targetClass="ro.davidmontei.loom.headless.CommandActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="downloads"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_downloads"
        android:shortcutShortLabel="@string/shortcut_downloads_short"
        android:shortcutLongLabel="@string/shortcut_downloads_long">
        <intent
            android:action="ro.davidmontei.loom.action.OPEN_QUEUE"
            android:targetPackage="ro.davidmontei.loom"
            android:targetClass="ro.davidmontei.loom.MainActivity" />
    </shortcut>
</shortcuts>
