<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is backed up or transferred: the token is sealed with a device-bound Keystore key
     (useless elsewhere) and the catalog is re-synced from RomM in minutes. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
